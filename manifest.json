{
  "manifest_version": 3,
  "name": "FB Auto Ảnh + Caption",
  "version": "1.3.0",
  "description": "Mở hộp Create post trên Facebook: tự điền 1 caption + 1 ảnh ngẫu nhiên, không trùng giữa các profile (thư mục chung trong Downloads). Ảnh ghép được tự cắt thành từng ảnh.",
  "permissions": [
    "storage",
    "offscreen",
    "downloads",
    "downloads.ui",
    "scripting"
  ],
  "host_permissions": [
    "file:///*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FB Auto Ảnh + Caption",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lister.html"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ]
    }
  ]
}
